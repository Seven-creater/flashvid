{
  "schema_version": 1,
  "experiment_id": "role-separated-perception-memory-process-sft-v1",
  "runtime_contract": {
    "backend": "perception_memory_eva",
    "agent_version": "perception_memory_v1",
    "same_runtime_baseline_required": true,
    "same_prompt_hash_required": true,
    "same_config_hash_required": true,
    "prompt_selection_on_test_forbidden": true,
    "test_access_before_dev_winner_forbidden": true,
    "candidate_rerun": false
  },
  "roles": {
    "planner": {
      "base_model": "Qwen3.5-9B",
      "adapter": "trainable_planner_lora",
      "trainable": true,
      "media_count": 0,
      "loss_targets": [
        "evidence_request",
        "frame_select",
        "continue_stop"
      ]
    },
    "observer": {
      "base_model": "Qwen3.5-9B",
      "adapter": "frozen_base",
      "trainable": false,
      "candidate_blind": true,
      "input_scope": "current_frame_batch_only"
    },
    "verifier": {
      "base_model": "Qwen3.5-9B",
      "adapter": "frozen_base",
      "trainable": false,
      "candidate_blind": true,
      "input_scope": "public_question_options_and_observed_frames_only"
    },
    "answerer": {
      "base_model": "Qwen3.5-9B",
      "adapter": "frozen_base",
      "trainable": false,
      "candidate_blind": true,
      "input_scope": "ledger_and_up_to_16_verifier_cited_frames"
    }
  },
  "shared_adapter_across_roles_forbidden": true,
  "process_sft": {
    "source_split": "train600_only",
    "templates": [
      "single_frame_select",
      "timestamp_grounded_select",
      "hierarchical_refinement",
      "multi_interval_exploration"
    ],
    "minimum_real_frame_selects_per_question": 1,
    "quality_contract_version": "role_separated_process_sft_quality_v1",
    "visual_path_classifier_version": "visual_path_classifier_v1",
    "candidate_training_strata": [
      "candidate_correct",
      "candidate_wrong"
    ],
    "candidate_strata_ratio_min": 0.9,
    "candidate_strata_ratio_max": 1.1,
    "observed_continue_stop_ratio_min": 0.9,
    "observed_continue_stop_ratio_max": 1.1,
    "visual_path_all_families_required": true,
    "visual_path_max_min_ratio": 1.1,
    "real_tool_loop_required": true,
    "incomplete_prefix_targets_continue": true,
    "complete_prefix_stop_requires_3_of_3": true,
    "tool_observations_masked": true,
    "hidden_reasoning_masked": true,
    "test300_training_forbidden": true,
    "ground_truth_join_after_model_requests": true
  },
  "training_quantity": {
    "policy": "report_only",
    "blocks_training": false,
    "observed_questions": null,
    "observed_prefixes": null,
    "candidate_fix_questions": null,
    "advisory_targets": {
      "questions": 360,
      "per_dataset": 100,
      "candidate_fix_questions": 90
    }
  },
  "data": {

        "artifact_sha256": "10cf7c7fe364e381ecb2dcc3890f6a87df7d9be2cc67c20975993dc01f62b999"
      }
    },
    "cells": [
      {
        "id": "base_all",
        "bindings": {"planner": "base", "observer": "base", "verifier": "base", "answerer": "base"}
      },
      {
        "id": "planner_old_lora",
        "bindings": {"planner": "candidate", "observer": "base", "verifier": "base", "answerer": "base"}
      },
      {
        "id": "observer_old_lora",
        "bindings": {"planner": "base", "observer": "candidate", "verifier": "base", "answerer": "base"}
      },
      {
        "id": "verifier_old_lora",
        "bindings": {"planner": "base", "observer": "base", "verifier": "candidate", "answerer": "base"}
      },
      {
        "id": "answerer_old_lora",
        "bindings": {"planner": "base", "observer": "base", "verifier": "base", "answerer": "candidate"}
      },
      {
        "id": "old_lora_all",
        "bindings": {"planner": "candidate", "observer": "candidate", "verifier": "candidate", "answerer": "candidate"}
      }
    ]
  },
  "sources": [
    {
      "name": "efficient_video_agent",
      "repository_url": "https://github.com/wangruohui/EfficientVideoAgent.git",
      "commit": "758ad8d3dcb84a8086e5d70c9afb9a6f278e8f5a",
      "paper_url": "https://arxiv.org/abs/2603.22918",
      "reuse_boundary": "Reuse official frame_select, tool-call loop, tool-role messages, and visual-budget fallback semantics.",
      "excluded_boundary": "Do not claim the unpublished training pipeline; do not attribute KTO or GRPO gains to SFT."
    },
    {
      "name": "time_search_r",
      "repository_url": "https://github.com/Time-Search/TimeSearch-R.git",
      "commit": "e427ee64b54a0668520baa4086f7120fd63813f4",
      "paper_url": "https://arxiv.org/abs/2511.05489",
      "reuse_boundary": "Reuse tools-disabled completeness self-verification as a stop/evidence audit concept.",
      "excluded_boundary": "Do not reuse SigLIP or DPP retrieval; do not report GRPO-CSV gains as SFT gains."
    },
    {
      "name": "frame_thinker",
      "repository_url": "https://github.com/lcqysl/FrameThinker.git",
      "commit": "3c917f3a7d311e91ae2ac1ebdb30723850e4508e",
      "paper_url": "https://arxiv.org/abs/2509.24304",
      "reuse_boundary": "Reuse the five SFT trajectory templates and cognitive-consistency validation rules.",
      "excluded_boundary": "Do not reuse RL rewards or claim final accuracy/frame improvements as SFT effects."
    },
    {
      "name": "long_vt",
      "repository_url": "https://github.com/EvolvingLMMs-Lab/LongVT.git",
      "commit": "08d755b973e4ad990ac5cdd64fb992c804d840db",
      "paper_url": "https://arxiv.org/abs/2511.20785",
      "reuse_boundary": "Reuse real crop/tool-response episode structure and the documented need to control accumulated visual history.",
      "excluded_boundary": "Do not import semantic scene tools; do not attribute RL or RFT results to SFT."
    },
    {
      "name": "long_video_r1",
      "repository_url": "https://github.com/qiujihao19/LongVideo-R1.git",
      "commit": "5c3e7ba00e1ee24ede3f190da9bd992ae6e005bb",
      "paper_url": "https://arxiv.org/abs/2602.20913",
      "reuse_boundary": "Reuse global-to-local hierarchical episode layout and explicit continue/terminate supervision.",
      "excluded_boundary": "Do not use ground-truth clue intervals, external 32B/72B tools, or RL results."
    },
    {
      "name": "long_video_agent",
      "repository_url": "https://github.com/longvideoagent/LongVideoAgent.git",
      "commit": "6edd180b0c5b41c0c5f00e3d96f482a4eb5b27e2",
      "paper_url": "https://arxiv.org/abs/2512.20618",
      "reuse_boundary": "Reuse role isolation and text-only observations returned from a frozen perception role to a trainable controller.",
      "excluded_boundary": "Do not use subtitles, proprietary grounding/vision services, or report its RL gains as SFT gains."
    },
    {
      "name": "video_mind",
      "repository_url": "https://github.com/yeliudev/VideoMind.git",
      "commit": "6721d2564eeb9ea8ab6c0ab8eaa39bd231ee8927",
      "paper_url": "https://arxiv.org/abs/2503.13444",
      "reuse_boundary": "Reuse role-specific adapter separation and independent planner/grounder/verifier supervision boundaries.",
      "excluded_boundary": "Do not collapse role adapters into one LoRA or import unrelated datasets/models into the fixed experiment."
    }
  ],
  "orchestration": {
    "source_lock_path": "configs/source_locks/role_separated_process_sft_sources.lock.json",
    "role_ablation_output": "results/eval/role_separated_process_sft/role_ablation",
    "gate_cli": "scripts/gate_perception_memory.py",
    "setsid": true,
    "nohup": true,
    "resume": true,
    "stop_if_dev_gate_fails": true,
    "test_launch_from_role_ablation_forbidden": true
  }
}

  "gates": {
    "implementation": "flashvid_eval.perception_memory_gate",
    "dev": {
      "baseline": "same_runtime_untrained",
      "aggregate_seeds": [17, 42, 73],
      "minimum_gain_out_of_150": 3,
      "per_dataset_non_decrease": true,
      "maximum_total_token_ratio": 0.7,
      "maximum_visual_token_ratio": 0.7,
      "maximum_engineering_failure_rate": 0.01,
      "annotation_leak_required": 0,
      "candidate_rerun_required": 0,
      "duplicate_sample_id_required": 0
    },
    "test": {
      "requires_frozen_dev_winner": true,
      "run_once": true,
      "minimum_gain_out_of_300": 6,
      "minimum_total_correct": 157,
      "minimum_dataset_correct": {
        "lvbench": 45,
        "lsdbench": 63,
        "cgbench": 43
      },
      "per_dataset_non_decrease": true,
      "maximum_total_token_ratio": 0.7,
      "maximum_visual_token_ratio": 0.7,
      "maximum_engineering_failure_rate": 0.01,
      "annotation_leak_required": 0,
      "candidate_rerun_required": 0,
      "duplicate_sample_id_required": 0
    }
  },
  "role_ablation": {
    "split": "dev",
    "samples_per_dataset": 10,
    "total_samples": 30,
    "seeds": [42],
    "may_select_prompt": false,
    "test_access": "forbidden",
    "purpose": "attribute regression to the adapter role before any new SFT selection",
    "causal_contract": {
      "base_all_mode": "end_to_end_source_for_frozen_inputs",
      "planner_old_lora_mode": "end_to_end_system_intervention",
      "observer_old_lora_mode": "fixed_observer_pair_with_base_downstream",
      "verifier_old_lora_mode": "fixed_verifier_pair",
      "answerer_old_lora_mode": "fixed_answerer_pair",
      "old_lora_all_mode": "end_to_end_interaction_not_single_role_causal",
      "frame_content_sha256_required": true,
      "same_frozen_request_sha256_required": true,
      "offline_scoring_after_both_arms": true
    },
    "manifest_derivation": "first_10_rows_of_each_sha256_frozen_dev_manifest",
    "artifacts": {
      "base": {
        "base_url": "http://127.0.0.1:8200/v1",
        "model": "Qwen3.5-9B",
